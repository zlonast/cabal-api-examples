
-- The API branch checkout, as a sibling directory:
--   git clone --branch zlonast/cabal-install-api https://github.com/haskell/cabal cabal
packages: ../cabal/Cabal
packages: ../cabal/Cabal-syntax
packages: ../cabal/cabal-install-solver
packages: ../cabal/hooks-exe
packages: ../cabal/cabal-install-internal
packages: ../cabal/cabal-install

-- The real reverse dependencies, vendored with their migration patches applied
-- (see README): hackage-revdeps, cabal-matrix, cabal-add, cabal-hoogle.
packages: ports/hackage-revdeps
packages: ports/cabal-matrix
packages: ports/cabal-add
packages: ports/cabal-hoogle
packages: ports/hix/packages/hix
packages: ports/cabal-buck2
packages: ports/guardian

-- guardian's stack adapter pulls in the whole of stack; the cabal adapter is the port
package guardian
  flags: -stack -test-cabal-plan -test-graphmod

-- guardian is unmaintained upstream: several of its dependencies carry stale
-- upper bounds on base. The libraries themselves build fine on modern GHC.
allow-newer: guardian:regex-applicative-text
            , guardian:bytestring-trie
            , guardian:language-dot
