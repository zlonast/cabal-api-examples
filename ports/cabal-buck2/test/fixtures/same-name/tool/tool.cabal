cabal-version:      2.4
name:               tool
version:            0.1.0.0
build-type:         Simple

-- A library and an executable with the package's own name: a common layout
-- (the executable is a thin wrapper around the library), but a buck2 target
-- name has to be unique within its package.
library
  exposed-modules:   Tool
  hs-source-dirs:    src
  build-depends:     base
  default-language:  Haskell2010

executable tool
  main-is:           Main.hs
  hs-source-dirs:    app
  build-depends:     base, tool
  default-language:  Haskell2010
